<Project Sdk="Microsoft.NET.Sdk">
  <!-- Melange Mixers: mixing stations that take two, three or four ingredients in one go (a Melange spoke; needs Melange Core).
       Shared settings: ../Directory.Build.props -->
  <PropertyGroup>
    <AssemblyName>MelangeMixers</AssemblyName>
    <RootNamespace>Melange.Mixers</RootNamespace>
    <!-- S1API is compiled against a pinned copy: -p:S1ApiDll=..., then ../lib (gitignored), then the game's Mods. -->
    <S1ApiDll Condition="'$(S1ApiDll)' == '' And Exists('$(MSBuildThisFileDirectory)../lib/S1API.Il2Cpp.MelonLoader.dll')">$(MSBuildThisFileDirectory)../lib/S1API.Il2Cpp.MelonLoader.dll</S1ApiDll>
    <S1ApiDll Condition="'$(S1ApiDll)' == ''">$(GameDir)/Mods/S1API.Il2Cpp.MelonLoader.dll</S1ApiDll>
    <ArtOut>$(MSBuildThisFileDirectory)../scripts/art/out</ArtOut>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="S1API.Il2Cpp.MelonLoader"><HintPath>$(S1ApiDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Interop)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Interop)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Interop)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(Interop)/UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(Interop)/UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <ProjectReference Include="../MelangeCore/MelangeCore.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The machines' models, built by scripts/art/build_mixers.py (Blender), embedded when they exist. Without them the
         machines wear the Mk2's own look, tinted per tier (Looks.cs). -->
    <EmbeddedResource Include="$(ArtOut)/mixer2.mesh.json" LogicalName="MelangeMixers.mixer2.mesh.json" Condition="Exists('$(ArtOut)/mixer2.mesh.json')" />
    <EmbeddedResource Include="$(ArtOut)/mixer3.mesh.json" LogicalName="MelangeMixers.mixer3.mesh.json" Condition="Exists('$(ArtOut)/mixer3.mesh.json')" />
    <EmbeddedResource Include="$(ArtOut)/mixer4.mesh.json" LogicalName="MelangeMixers.mixer4.mesh.json" Condition="Exists('$(ArtOut)/mixer4.mesh.json')" />
  </ItemGroup>
</Project>
