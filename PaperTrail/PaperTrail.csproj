<Project Sdk="Microsoft.NET.Sdk">
  <!-- Paper Trail: rolling auto-saves and a save/load screen. Shared settings: ../Directory.Build.props -->
  <PropertyGroup>
    <AssemblyName>PaperTrail</AssemblyName>
    <RootNamespace>PaperTrail</RootNamespace>
    <!-- dotnet build -p:Dev=true compiles in the test driver (DevInspect); release builds never contain it. -->
    <DefineConstants Condition="'$(Dev)' == 'true'">$(DefineConstants);PT_DEV</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Interop)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Interop)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Interop)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Interop)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Interop)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
